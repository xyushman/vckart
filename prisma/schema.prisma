generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  DEMO
}

model Product {
  id                 Int                  @id @default(autoincrement())
  name               String
  category           String
  price              Float
  imageUrl           String?
  source             String               @default("admin")
  sourceProductId    String?
  availability       Boolean              @default(true)
  attributes         Json?                // Stores dynamic filters like size, color, material
  ShoppingListItem   ShoppingListItem[]
}

model ShoppingListItem {
  id               Int      @id @default(autoincrement())
  sessionId        String
  product          Product? @relation(fields: [productId], references: [id])
  productId        Int?
  rawProductName   String
  category         String   @default("Uncategorized")
  quantity         Int
  unit             String
  isPurchased      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ConversationSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  state       Json     // Stores the entire ConversationState (filters, query, awaitingInput)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConversationMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String   // 'user' | 'assistant'
  message     String
  intent      String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------
// NextAuth Standard Models for Production SaaS
// ------------------------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
